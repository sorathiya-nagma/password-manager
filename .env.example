DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
VAULT_FERNET_KEY=generate-with-python-command-in-readme

# Security
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_COOKIE_AGE=1800
SESSION_INACTIVITY_SECONDS=900
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False

# Email reset links use console output by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SecureVault <noreply@example.com>

# Optional PostgreSQL
DATABASE_ENGINE=sqlite
POSTGRES_DB=securevault
POSTGRES_USER=securevault
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
